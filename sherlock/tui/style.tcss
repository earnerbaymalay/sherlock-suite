/* Sherlock Suite Modern Dark Theme */

Screen {
    layout: vertical;
    background: $background;
}

Header {
    dock: top;
    height: 3;
    background: #0f172a;
    color: #38bdf8;
    text-style: bold;
}

Footer {
    dock: bottom;
    height: 1;
    background: #0f172a;
    color: #94a3b8;
}

/* Control Panel */
#control-panel {
    height: auto;
    background: #1e293b;
    border-bottom: heavy #38bdf8;
    padding: 1 2;
}

#target-row {
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

#target-label {
    width: 14;
    text-style: bold;
    color: #f8fafc;
    padding-top: 1;
}

#target-input {
    width: 40;
    margin-right: 2;
    border: tall #0284c7;
}

#depth-label {
    width: 8;
    text-style: bold;
    color: #f8fafc;
    padding-top: 1;
}

#depth-select {
    width: 20;
    margin-right: 2;
}

#buttons-row {
    height: 3;
    align: left middle;
}

Button {
    margin-right: 1;
    min-width: 14;
}

#btn-run {
    background: #0284c7;
    color: #ffffff;
    text-style: bold;
}
#btn-run:hover {
    background: #0369a1;
}

#btn-cancel {
    background: #ef4444;
    color: #ffffff;
}

#btn-export {
    background: #059669;
    color: #ffffff;
}

#btn-clear {
    background: #475569;
    color: #ffffff;
}

/* Modules row */
#modules-row {
    height: auto;
    margin-top: 1;
    align: left middle;
}

#modules-label {
    width: 14;
    text-style: bold;
    color: #94a3b8;
}

Checkbox {
    margin-right: 2;
    background: transparent;
    color: #e2e8f0;
}

/* Stats / Status Bar */
#stats-bar {
    height: 4;
    background: #0f172a;
    border-bottom: solid #334155;
    padding: 0 2;
    align: center middle;
}

.stat-card {
    width: 1fr;
    height: 3;
    background: #1e293b;
    border: solid #334155;
    margin: 0 1;
    padding: 0 1;
    align: center middle;
}

.stat-title {
    color: #94a3b8;
    text-style: bold;
    text-align: center;
}

.stat-value {
    color: #38bdf8;
    text-style: bold;
    text-align: center;
}

.stat-risk-low {
    color: #10b981;
}
.stat-risk-med {
    color: #f59e0b;
}
.stat-risk-high {
    color: #ef4444;
}

/* Progress area */
#progress-container {
    height: 2;
    background: #0f172a;
    padding: 0 2;
    align: left middle;
}

#progress-bar {
    width: 60%;
    margin-right: 2;
}

#status-label {
    color: #cbd5e1;
}

/* Main Workspace */
#main-container {
    height: 1fr;
    background: $background;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0 1;
}

/* DataTable styling */
DataTable {
    height: 1fr;
    background: #0f172a;
    border: solid #1e293b;
}

#filter-bar {
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
    align: left middle;
}

#filter-label {
    width: 12;
    text-style: bold;
    color: #94a3b8;
    padding-top: 1;
}

#severity-filter {
    width: 22;
    margin-right: 2;
}

#search-filter {
    width: 35;
}

/* Activity Log */
#activity-log {
    height: 1fr;
    background: #020617;
    border: solid #1e293b;
    color: #e2e8f0;
}

/* Summary View */
#summary-scroll {
    height: 1fr;
    background: #0f172a;
    padding: 1 2;
}
